---
import { t } from '../i18n/en';
import type { Section } from '../lib/case-study';

interface Props {
  section: Section;
}

const { section } = Astro.props;
---

<div class="case-study">
  {
    section.items ? (
      <ul class="entries">
        {section.items.map((item) =>
          item.fields.length > 0 ? (
            <li>
              <strong set:html={item.title} />
              <ul>
                {item.fields.map((f) => (
                  <li>
                    <span class="label">{t.caseStudy.labels[f.label]}:</span> <Fragment set:html={f.html} />
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <strong set:html={`${item.title}:`} /> <Fragment set:html={item.text} />
            </li>
          ),
        )}
      </ul>
    ) : (
      <div class="prose" set:html={section.html} />
    )
  }
</div>

<style>
  .case-study {
    min-width: 0;
  }
  .case-study > * {
    min-width: 0;
  }
  .label {
    font-weight: 600;
    color: var(--accent);
  }
  .entries {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 12px;
  }
  .entries ul {
    margin: 4px 0 0;
    padding-left: 1.2em;
    color: var(--muted);
  }
</style>
