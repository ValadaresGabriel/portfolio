---
import Base from '../../layouts/Base.astro';
import AreaSection from '../../components/AreaSection.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { t } from '../../i18n/en';
import { parseCaseStudy } from '../../lib/case-study';
import { gameAreas, getGames, youtubeId, type Game } from '../../lib/content';

export async function getStaticPaths() {
  const games = await getGames();
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

interface Props {
  game: Game;
}

const { game } = Astro.props;
const g = game.data;
const areas = gameAreas(game);
const trailerId = youtubeId(g.links.trailer);
const study = await parseCaseStudy(game.body);
const skills = study?.skills?.items ?? [];
// Anything outside the template (hand-edited in the CMS) keeps its own heading.
const extras = study?.others ?? [];
const hasStudy = Boolean(study?.highlights);
const hasMedia = Boolean(trailerId) || g.gallery.length > 0;

// The page outline, in reading order. It drives both the sections and the summary bar.
const outline = [
  { id: 'overview', label: t.game.sections.overview, show: true },
  { id: 'media', label: t.game.sections.media, show: hasMedia },
  { id: 'role', label: t.game.sections.role, show: areas.length > 0 },
  { id: 'highlights', label: t.caseStudy.sections.highlights, show: Boolean(study?.highlights) },
  { id: 'decisions', label: t.caseStudy.sections.decisions, show: Boolean(study?.decisions) },
  ...extras.map((x, i) => ({ id: `more-${i + 1}`, label: x.name, show: true })),
].filter((x) => x.show);

const facts = [
  { label: t.game.role, value: g.role },
  { label: t.game.type, value: t.type[g.type] },
  { label: t.game.status, value: t.status[g.status] },
  { label: t.game.period, value: g.period },
  { label: t.game.team, value: g.teamSize ? t.game.people(g.teamSize) : undefined },
  { label: t.game.genre, value: g.genre },
  { label: t.game.platforms, value: g.platforms.join(', ') || undefined },
  { label: t.game.engine, value: g.engine },
].filter((f) => f.value);
---

<Base title={g.title} description={g.pitch} image={g.cover}>
  <article class="container section page">
    <a class="back" href="/games/">← {t.game.back}</a>

    <header class="top sec" id="overview">
      <img class="cover" src={g.cover} alt="" width="1200" height="675" />
      <div class="intro">
        <ul class="chips">
          {areas.map((a) => <li><a class="area-badge" data-area={a} href={`#${a}`}>{t.areaShort[a]}</a></li>)}
        </ul>
        <h1>{g.title}</h1>
        <p class="pitch">{g.pitch}</p>
        {g.description && <p class="muted">{g.description}</p>}
        {
          skills.length > 0 && (
            <ul class="chips skills" aria-label={t.caseStudy.sections.skills}>
              {skills.map((s) => <li class="chip" set:html={s.title} />)}
            </ul>
          )
        }
        <div class="btn-row">
          {g.links.play && <a class="btn btn-primary" href={g.links.play} target="_blank" rel="noopener">{t.game.play} ↗</a>}
          {g.links.trailer && !trailerId && <a class="btn" href={g.links.trailer} target="_blank" rel="noopener">{t.game.trailer} ↗</a>}
          {g.links.repo && <a class="btn" href={g.links.repo} target="_blank" rel="noopener">{t.game.repo} ↗</a>}
        </div>
      </div>
    </header>

    <nav class="toc" aria-label={t.game.toc}>
      <span class="toc-label">{t.game.toc}</span>
      <ol>
        {outline.map((x) => <li><a href={`#${x.id}`}>{x.label}</a></li>)}
      </ol>
    </nav>

    <dl class="facts card">
      {
        facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>

    {
      g.credits.length > 0 && (
        <section class="team card" aria-labelledby="team">
          <h2 id="team">{t.game.credits}</h2>
          <ul>
            {g.credits.map((c) => (
              <li>
                <strong>{c.name}</strong>
                {c.role && <span class="muted"> · {c.role}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      hasMedia && (
        <section class="sec" id="media">
          <h2>{t.game.sections.media}</h2>
          {trailerId && (
            <div class="trailer">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${trailerId}`}
                title={`${g.title}: ${t.game.trailer}`}
                loading="lazy"
                allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
          )}
          {g.gallery.length > 0 && (
            <div class="shots">
              {g.gallery.map((item) => (
                <figure>
                  <a href={item.image} target="_blank" rel="noopener">
                    <img src={item.image} alt={item.caption ?? ''} loading="lazy" />
                  </a>
                  {item.caption && <figcaption class="muted">{item.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}
        </section>
      )
    }

    {
      areas.length > 0 && (
        <section class="sec" id="role">
          <h2>{t.game.sections.role}</h2>
          <div class="areas">
            {areas.map((area) => <AreaSection game={game} area={area} compact={hasStudy} />)}
          </div>
        </section>
      )
    }

    {
      study?.highlights && (
        <section class="sec" id="highlights">
          <h2>{t.caseStudy.sections.highlights}</h2>
          {study.intro && <div class="prose" set:html={study.intro} />}
          <CaseStudy section={study.highlights} />
        </section>
      )
    }
    {
      study?.decisions && (
        <section class="sec" id="decisions">
          <h2>{t.caseStudy.sections.decisions}</h2>
          <CaseStudy section={study.decisions} />
        </section>
      )
    }
    {
      extras.map((x, i) => (
        <section class="sec" id={`more-${i + 1}`}>
          <h2>{x.name}</h2>
          <CaseStudy section={x} />
        </section>
      ))
    }
  </article>
</Base>

<script>
  // Highlight the summary link of the section being read.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.toc a').forEach((a) => links.set(a.hash.slice(1), a));
  const sections = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);

  function update() {
    // The current section is the last one whose top has passed under the sticky bars.
    const line = 140;
    let current = sections[0];
    for (const el of sections) if (el.getBoundingClientRect().top <= line) current = el;
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) current = sections[sections.length - 1];
    links.forEach((a, id) => {
      const on = id === current?.id;
      if (on && !a.hasAttribute('aria-current')) a.parentElement?.parentElement?.scrollTo({ left: a.offsetLeft - 16, behavior: 'smooth' });
      a.toggleAttribute('aria-current', on);
    });
  }
  addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .back {
    display: inline-block;
    margin-bottom: 20px;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--text);
  }
  /* Single column, read top to bottom. */
  .page {
    max-width: 820px;
  }
  .top {
    display: grid;
    gap: 28px;
  }
  /* Sections stop below the site header and the summary bar when jumped to. */
  .sec {
    scroll-margin-top: 130px;
  }
  .sec + .sec,
  .team + .sec,
  .facts + .sec {
    margin-top: 48px;
  }
  .sec > h2 {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 20px;
  }
  .toc {
    position: sticky;
    top: 61px;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 28px calc(var(--gutter) * -1) 0;
    padding: 10px var(--gutter);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-block: 1px solid var(--border);
  }
  .toc-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .toc-label {
      display: none;
    }
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 6px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    position: relative;
  }
  .toc a {
    display: block;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid transparent;
    color: var(--muted);
    font-size: 0.88rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .toc a:hover {
    color: var(--text);
  }
  .toc a[aria-current] {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .skills {
    margin-bottom: 18px;
  }
  .shots {
    display: grid;
    gap: 18px;
  }
  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .intro .chips {
    margin-bottom: 12px;
  }
  .intro .area-badge {
    text-decoration: none;
  }
  .pitch {
    font-size: 1.15rem;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 170px), 1fr));
    gap: 16px 24px;
    padding: 20px 24px;
    margin: 24px 0 32px;
  }
  dt {
    font-size: 0.8rem;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-weight: 600;
  }
  .team {
    padding: 20px 24px;
    margin: -12px 0 32px;
  }
  .team h2 {
    font-size: 0.8rem;
    font-family: var(--font);
    font-weight: 400;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .team ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
  }
  .trailer {
    aspect-ratio: 16 / 9;
    margin-bottom: 18px;
  }
  .trailer iframe {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: var(--radius);
  }
  .areas {
    display: grid;
    gap: 24px;
  }
  figure {
    margin: 0;
  }
  figure img {
    border-radius: 10px;
    border: 1px solid var(--border);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    width: 100%;
  }
  figcaption {
    font-size: 0.85rem;
    margin-top: 6px;
  }
</style>
